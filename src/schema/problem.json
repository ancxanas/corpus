{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus:problem",
  "type": "object",
  "required": ["corpus", "payload"],
  "properties": {
    "corpus": {
      "allOf": [
        { "$ref": "corpus:defs#/$defs/corpus" },
        { "properties": { "node_type": { "const": "Problem" } } }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["problem"],
      "properties": {
        "problem": {
          "type": "object",
          "required": [
            "title",
            "severity",
            "symptoms",
            "root_cause",
            "environment"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 120 },
            "severity": { "enum": ["critical", "high", "medium", "low"] },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "impact": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "reproduction": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title", "body"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "body": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "diagnosis": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title", "body"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "body": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "tags": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "maxItems": 20
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "url"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "symptoms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type", "description", "observable", "frequency"],
                "properties": {
                  "type": {
                    "enum": [
                      "runtime_behavior",
                      "error_message",
                      "performance_degradation"
                    ]
                  },
                  "description": { "type": "string", "minLength": 1 },
                  "observable": { "type": "string", "minLength": 1 },
                  "frequency": {
                    "enum": ["always", "intermittent", "race_condition"]
                  }
                },
                "additionalProperties": false
              }
            },
            "root_cause": {
              "type": "object",
              "required": ["mechanism", "causal_chain"],
              "properties": {
                "mechanism": { "type": "string", "minLength": 1 },
                "causal_chain": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            },
            "environment": {
              "type": "object",
              "required": ["runtime", "framework"],
              "properties": {
                "runtime": {
                  "type": "object",
                  "required": ["type", "versions"],
                  "properties": {
                    "type": { "type": "string", "minLength": 1 },
                    "versions": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  },
                  "additionalProperties": false
                },
                "framework": {
                  "type": "object",
                  "required": ["name", "version"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                },
                "agent_context": { "$ref": "corpus:defs#/$defs/agentContext" }
              },
              "additionalProperties": false
            },
            "solutions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["node"],
                "properties": {
                  "node": { "$ref": "corpus:defs#/$defs/ipldLink" },
                  "applies_to": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
