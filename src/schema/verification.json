{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus:verification",
  "type": "object",
  "required": ["osk", "payload"],
  "properties": {
    "osk": {
      "allOf": [
        { "$ref": "corpus:defs#/$defs/osk" },
        { "properties": { "node_type": { "const": "Verification" } } }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["verification"],
      "properties": {
        "verification": {
          "type": "object",
          "required": ["target", "execution", "timestamp"],
          "properties": {
            "target": {
              "type": "object",
              "required": ["problem_id", "solution_id"],
              "properties": {
                "problem_id": { "$ref": "corpus:defs#/$defs/ipldLink" },
                "solution_id": { "$ref": "corpus:defs#/$defs/ipldLink" }
              },
              "additionalProperties": false
            },
            "execution": {
              "type": "object",
              "required": ["playground", "environment_hash", "test_suite"],
              "properties": {
                "playground": { "type": "string", "minLength": 1 },
                "environment_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "test_suite": {
                  "type": "object",
                  "required": ["total", "passed", "failed", "cases"],
                  "properties": {
                    "total": { "type": "integer", "minimum": 0 },
                    "passed": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "cases": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["name", "expected", "actual", "result"],
                        "properties": {
                          "name": { "type": "string", "minLength": 1 },
                          "input_cid": {
                            "$ref": "corpus:defs#/$defs/ipldLink"
                          },
                          "expected": { "type": "string" },
                          "actual": { "type": "string" },
                          "result": { "enum": ["pass", "fail"] }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "timestamp": { "$ref": "corpus:defs#/$defs/iso8601" },
            "valid_until": { "$ref": "corpus:defs#/$defs/iso8601" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
