{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus:reference",
  "type": "object",
  "required": ["osk", "payload"],
  "properties": {
    "osk": {
      "allOf": [
        { "$ref": "corpus:defs#/$defs/osk" },
        { "properties": { "node_type": { "const": "Reference" } } }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "object",
          "required": ["title", "topic", "source", "entries", "consistency"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 120 },
            "topic": { "type": "string", "minLength": 1 },
            "source": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "official_docs",
                    "specification",
                    "source_code",
                    "vendor_docs"
                  ]
                },
                "url": { "type": "string", "minLength": 1 },
                "snapshot_cid": { "$ref": "corpus:defs#/$defs/ipldLink" },
                "synced_at": { "$ref": "corpus:defs#/$defs/iso8601" }
              },
              "additionalProperties": false
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "description",
                  "version",
                  "source_pointer"
                ],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "kind": {
                    "enum": ["function", "type", "flag", "config", "behavior"]
                  },
                  "signature": { "type": ["string", "null"] },
                  "description": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "source_pointer": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "consistency": {
              "type": "object",
              "required": ["method", "last_checked", "result"],
              "properties": {
                "method": {
                  "enum": ["source_sync", "manual", "agent_verification"]
                },
                "last_checked": { "$ref": "corpus:defs#/$defs/iso8601" },
                "result": { "enum": ["confirmed", "drifted"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
