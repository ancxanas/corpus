{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus:blueprint",
  "type": "object",
  "required": ["osk", "payload"],
  "properties": {
    "osk": {
      "allOf": [
        { "$ref": "corpus:defs#/$defs/osk" },
        { "properties": { "node_type": { "const": "Blueprint" } } }
      ]
    },
    "payload": {
      "type": "object",
      "required": ["blueprint"],
      "properties": {
        "blueprint": {
          "type": "object",
          "required": [
            "title",
            "current_landscape",
            "proposed_architecture",
            "rationale",
            "feasibility",
            "epistemic_status",
            "confidence"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 120 },
            "current_landscape": {
              "type": "object",
              "required": ["fragments", "systemic_friction"],
              "properties": {
                "fragments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["technology", "purpose", "limitations"],
                    "properties": {
                      "technology": { "type": "string", "minLength": 1 },
                      "purpose": { "type": "string", "minLength": 1 },
                      "limitations": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "systemic_friction": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "proposed_architecture": {
              "type": "object",
              "required": ["core_principle", "layers"],
              "properties": {
                "core_principle": { "type": "string", "minLength": 1 },
                "layers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "layer",
                      "name",
                      "technology",
                      "responsibility"
                    ],
                    "properties": {
                      "layer": { "type": "integer", "minimum": 1 },
                      "name": { "type": "string", "minLength": 1 },
                      "technology": { "type": "string", "minLength": 1 },
                      "responsibility": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "rationale": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "feasibility": {
              "type": "object",
              "required": ["blockers", "enablers"],
              "properties": {
                "blockers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["issue", "type", "severity"],
                    "properties": {
                      "issue": { "type": "string", "minLength": 1 },
                      "type": {
                        "enum": [
                          "implementation",
                          "social",
                          "economic",
                          "political"
                        ]
                      },
                      "severity": { "enum": ["high", "medium", "low"] }
                    },
                    "additionalProperties": false
                  }
                },
                "enablers": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            },
            "adoption_trajectory": {
              "type": "object",
              "required": ["phase_1", "phase_2", "phase_3"],
              "properties": {
                "phase_1": { "type": "string", "minLength": 1 },
                "phase_2": { "type": "string", "minLength": 1 },
                "phase_3": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "related_nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["node", "relation"],
                "properties": {
                  "node": { "$ref": "corpus:defs#/$defs/ipldLink" },
                  "relation": {
                    "enum": ["comparison", "prerequisite", "solves", "enables"]
                  }
                },
                "additionalProperties": false
              }
            },
            "epistemic_status": {
              "enum": [
                "vision",
                "feasible",
                "in_progress",
                "realized",
                "abandoned"
              ]
            },
            "confidence": { "enum": ["high", "medium", "low"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
